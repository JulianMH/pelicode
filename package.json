{
  "name": "pelicode",
  "displayName": "PeliCode",
  "description": "An Activity Bar chat assistant for VS Code",
  "version": "0.0.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JulianMH/pelicode.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pelicode",
          "title": "PeliCode",
          "icon": "media/chat.svg"
        }
      ]
    },
    "views": {
      "pelicode": [
        {
          "type": "webview",
          "id": "pelicode.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "pelicode.focusChat",
        "title": "Focus PeliCode Chat"
      },
      {
        "command": "pelicode.installCurrentVsix",
        "title": "Install Current VSIX"
      },
      {
        "command": "pelicode.openBrowserChat",
        "title": "PeliCode: Open Browser Chat"
      }
    ]
  },
  "scripts": {
    "dev": "node esbuild.js --dev",
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,svelte}\"",
    "format:check": "prettier --check \"src/**/*.{ts,svelte}\"",
    "export:html": "npm run check-types && npm run lint && node esbuild.js --html-only --production"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@types/ws": "^8.18.1",
    "dompurify": "^3.4.13",
    "esbuild": "^0.28.1",
    "esbuild-svelte": "^0.9.5",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "markdown-it": "^15.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "qrcode-generator": "^2.0.4",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "ws": "^8.21.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
